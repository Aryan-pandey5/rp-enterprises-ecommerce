# R.P. Enterprises — Environment Configuration Template
# Copy this file to .env and configure real credentials for production deployment.
# NEVER commit the actual .env file or real secrets to git.

# ----------------------------------------------------
# DJANGO SECURITY & SERVER CONFIGURATION
# ----------------------------------------------------
SECRET_KEY=your_production_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=rp-enterprises.onrender.com,yourdomain.com,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.vercel.app,https://yourdomain.com

# ----------------------------------------------------
# POSTGRESQL PRODUCTION DATABASE CONFIGURATION
# ----------------------------------------------------
# Provided by Render PostgreSQL or external PostgreSQL provider
DATABASE_URL=postgres://user:password@host:port/dbname

# ----------------------------------------------------
# CLOUDINARY MEDIA STORAGE (PRODUCT IMAGES)
# ----------------------------------------------------
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------------------------------------------
# META WHATSAPP BUSINESS CLOUD API INTEGRATION (OPTIONAL)
# ----------------------------------------------------
WHATSAPP_ADMIN_NUMBER=919305616979
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id_here
WHATSAPP_API_VERSION=v18.0
